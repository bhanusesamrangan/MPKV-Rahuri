    {
      "type": "ul",
      "items": [
        {
          "en": "कृषि विद्यापीठातील शास्त्रज्ञ अधिकारी शेतकरी यांच्यामध्ये समन्वय साधून त्यांना मार्गदर्शन करणे.",
          "mr": "कृषि विद्यापीठातील शास्त्रज्ञ अधिकारी शेतकरी यांच्यामध्ये समन्वय साधून त्यांना मार्गदर्शन करणे."
        },
        {
          "en": "शेतक-यांच्या आणि गावांच्या सर्वांगिण आर्थिक व सामाजिक विकासासाठी कृषि विद्यापीठामार्फत विविध योजना राबविणे.",
          "mr": "शेतक-यांच्या आणि गावांच्या सर्वांगिण आर्थिक व सामाजिक विकासासाठी कृषि विद्यापीठामार्फत विविध योजना राबविणे."
        },
        {
          "en": "विद्यापीठाने विकसीत केलेले संशोधीत तंत्रज्ञानाचा वापर करणेकरिता शेतक-यांना प्रवृत्त करणे.",
          "mr": "विद्यापीठाने विकसीत केलेले संशोधीत तंत्रज्ञानाचा वापर करणेकरिता शेतक-यांना प्रवृत्त करणे."
        },
        {
          "en": "शेतीविषयक परिस्थितीनुसार शेतक-यांकडून आलेल्या प्रश्नांची त्वरीत दखल घेऊन त्यानुसार संशोधनाचे नियोजन करणे.",
          "mr": "शेतीविषयक परिस्थितीनुसार शेतक-यांकडून आलेल्या प्रश्नांची त्वरीत दखल घेऊन त्यानुसार संशोधनाचे नियोजन करणे."
        },
        {
          "en": "मंचातील सभासदांच्या शेतीचा एक आदर्श निर्माण करणे त्याचे अनुकरण इतर शेतक-यांनी करणे बाबत प्रोत्साहन देणे.",
          "mr": "मंचातील सभासदांच्या शेतीचा एक आदर्श निर्माण करणे त्याचे अनुकरण इतर शेतक-यांनी करणे बाबत प्रोत्साहन देणे."
        }
      ],
      "order": 58
    },
    {
      "type": "ul",
      "items": [
        {
          "en": "शेतकरी-शास्त्रज्ञ मंचाची महिन्यातून एकदा बैठक आयोजित करणे आणि हंगामनिहाय शेतक-यांचे प्रश्न सोडविणे.",
          "mr": "शेतकरी-शास्त्रज्ञ मंचाची महिन्यातून एकदा बैठक आयोजित करणे आणि हंगामनिहाय शेतक-यांचे प्रश्न सोडविणे."
        },
        {
          "en": "विद्यापीठामार्फत घेण्यात येणा-या सर्व प्रात्यक्षिका मध्ये मंचाच्या सभासदाला प्राधान्य देणे.",
          "mr": "विद्यापीठामार्फत घेण्यात येणा-या सर्व प्रात्यक्षिका मध्ये मंचाच्या सभासदाला प्राधान्य देणे."
        },
        {
          "en": "मंचातील सभासद शेतक-यांची संपूर्ण माहिती प्रश्नावलीत भरुन तिचे विश्लेषण करुन मार्गदर्शन करणे.",
          "mr": "मंचातील सभासद शेतक-यांची संपूर्ण माहिती प्रश्नावलीत भरुन तिचे विश्लेषण करुन मार्गदर्शन करणे."
        },
        {
          "en": "मंचातील प्रत्येक सभासदराच्या जमिनीची आरोग्यपत्रिका तयार करुन पीक पध्दती आणिखत मात्रा सुचविणे.",
          "mr": "मंचातील प्रत्येक सभासदराच्या जमिनीची आरोग्यपत्रिका तयार करुन पीक पध्दती आणिखत मात्रा सुचविणे."
        },
        {
          "en": "पिकांचे फिरते चिकित्सालय तज्ञ पथकासह मंचातील सभासदांच्या गावांना प्राधान्य देणे.",
          "mr": "पिकांचे फिरते चिकित्सालय तज्ञ पथकासह मंचातील सभासदांच्या गावांना प्राधान्य देणे."
        },
        {
          "en": "कृषि विद्यापीठातील आयोजित करण्यात येणा-या सर्वचर्चासत्रे / कृषि प्रदर्शने / मेळावे/ प्रशिक्षण / शिवार फेरीमध्ये मंचातील सभासदांना निमंत्रित करणे.",
