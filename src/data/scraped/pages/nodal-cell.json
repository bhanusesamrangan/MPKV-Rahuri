  "paragraphs": [
    {
      "text": {
        "en": "ICAR Nodal Cell has been established in the University in 2016 for effective coordination between University and Agricultural Education Division, ICAR, New Delhi for better education, planning, strengthening linkages, human resources development and quality assurance of the higher agricultural education.",
        "mr": "ICAR Nodal Cell has been established in the University in 2016 for effective coordination between University and Agricultural Education Division, ICAR, New Delhi for better education, planning, strengthening linkages, human resources development and quality assurance of the higher agricultural education."
      },
      "order": 56
    }
  ],
